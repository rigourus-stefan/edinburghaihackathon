# Copy this file to .env and fill in your own key:
#   cp .env.example .env
# Or run `npm run setup`, which does it for you.
# .env is gitignored, so your key never gets committed. Never put a real key in this file.

# Your Nebius AI Studio API key (https://studio.nebius.com → API keys)
NEBIUS_API_KEY=your-nebius-api-key-here

# Optional settings (the defaults are fine)
# PORT=8000
# VISION_MODEL=google/gemma-3-27b-it
# STORY_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# RATE_LIMIT_PER_MIN=20
# CORS_ORIGIN=http://localhost:5173
